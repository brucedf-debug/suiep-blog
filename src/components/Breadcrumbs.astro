---
interface Props {
  items: { name: string; href?: string }[];
}

const { items } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    ...(item.href && { item: new URL(item.href, Astro.site).toString() }),
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<nav aria-label="Breadcrumb" class="mb-4 text-sm text-stone-500">
  <ol class="flex flex-wrap items-center gap-1">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1">
          {item.href ? (
            <a href={item.href} class="hover:text-green-700">
              {item.name}
            </a>
          ) : (
            <span class="text-stone-700" aria-current="page">
              {item.name}
            </span>
          )}
          {i < items.length - 1 && <span class="text-stone-300">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
