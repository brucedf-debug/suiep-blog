---
import { categories } from '../lib/categories';
import { siteName, siteTagline } from '../lib/site';

const navCategories = Object.entries(categories).slice(0, 4);
---

<header class="border-b border-stone-200 bg-white">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
    <a href="/" class="flex items-baseline gap-2">
      <span class="text-xl font-bold tracking-tight text-stone-900">{siteName}</span>
      <span class="hidden text-xs font-medium text-stone-500 sm:inline">{siteTagline}</span>
    </a>
    <nav class="hidden gap-6 text-sm font-medium text-stone-700 md:flex">
      {
        navCategories.map(([slug, cat]) => (
          <a href={`/category/${slug}/`} class="hover:text-green-700">
            {cat.name}
          </a>
        ))
      }
      <a href="/blog/" class="hover:text-green-700">All Posts</a>
      <a href="/about/" class="hover:text-green-700">About</a>
    </nav>
  </div>
</header>
