---
import { newsletterFieldName, newsletterFormAction } from '../lib/site';
---

{
  newsletterFormAction && (
    <section class="mx-auto max-w-2xl px-4 pb-16 pt-8 text-center">
      <h2 class="mb-2 text-xl font-bold text-stone-900">Get new posts in your inbox</h2>
      <p class="mb-5 text-sm text-stone-600">
        No spam — just an email when a new project or guide goes up.
      </p>
      <form method="post" action={newsletterFormAction} class="flex flex-wrap justify-center gap-3">
        <input
          type="email"
          name={newsletterFieldName}
          placeholder="you@example.com"
          required
          aria-label="Your email"
          class="min-w-[240px] rounded-lg border border-stone-200 px-4 py-3 text-sm"
        />
        <button
          type="submit"
          class="rounded-lg bg-green-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-green-800"
        >
          Subscribe
        </button>
      </form>
    </section>
  )
}
