---
import { Image } from 'astro:assets';
import { categories } from '../lib/categories';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, category, heroImage } = post.data;
const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---

<a href={`/blog/${post.id}/`} class="group block overflow-hidden rounded-lg border border-stone-200 transition hover:shadow-md">
  {heroImage && (
    <Image
      src={heroImage}
      alt={title}
      class="h-44 w-full object-cover"
      widths={[300, 600]}
      sizes="(min-width: 768px) 300px, 100vw"
    />
  )}
  <div class="p-4">
    <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-green-700">
      {categories[category].name}
    </p>
    <h3 class="mb-1 font-bold text-stone-900 group-hover:text-green-700">{title}</h3>
    <p class="mb-2 text-sm text-stone-600">{description}</p>
    <p class="text-xs text-stone-400">{formatDate(pubDate)}</p>
  </div>
</a>
