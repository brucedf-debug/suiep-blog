---
import { getCollection } from 'astro:content';
import PostCard from './PostCard.astro';
import type { CategorySlug } from '../lib/categories';

interface Props {
  currentId: string;
  category: CategorySlug;
}

const { currentId, category } = Astro.props;

const related = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((post) => post.id !== currentId && post.data.category === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

{
  related.length > 0 && (
    <section class="mx-auto max-w-3xl px-4 pb-16">
      <h2 class="mb-6 text-xl font-bold text-stone-900">Related Posts</h2>
      <div class="grid gap-6 grid-cols-1 sm:grid-cols-2 md:grid-cols-3">
        {related.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </section>
  )
}
