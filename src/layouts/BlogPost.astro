---
import Layout from './Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { categories } from '../lib/categories';
import { siteName } from '../lib/site';
import { authors, authorSlugFor } from '../lib/authors';
import { extractFaqItems } from '../lib/faq';
import { extractHowToSteps } from '../lib/howto';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, pubDate, updatedDate, category, heroImage } = entry.data;
const categoryMeta = categories[category];
const pageURL = new URL(Astro.url.pathname, Astro.site).toString();
const authorSlug = authorSlugFor(entry.data);
const author = authors[authorSlug];
const authorURL = `/author/${authorSlug}/`;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: author.name,
    url: new URL(authorURL, Astro.site).toString(),
    description: author.bio,
  },
  publisher: { '@type': 'Organization', name: siteName, url: Astro.site?.toString() },
  ...(heroImage && { image: new URL(heroImage.src, Astro.site).toString() }),
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageURL },
};

const howToSteps = extractHowToSteps(entry.body);
const howToJsonLd =
  howToSteps.length >= 2
    ? {
        '@context': 'https://schema.org',
        '@type': 'HowTo',
        name: title,
        description,
        step: howToSteps.map((step, i) => ({
          '@type': 'HowToStep',
          position: i + 1,
          name: step.name,
          text: step.text,
        })),
      }
    : null;

const faqItems = extractFaqItems(entry.body);
const faqJsonLd =
  faqItems.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      }
    : null;

const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: categoryMeta.name, href: `/category/${category}/` },
  { name: title },
];
---

<Layout title={title} description={description} image={heroImage}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  {howToJsonLd && <script type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} />}
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
  <article class="mx-auto max-w-3xl px-4 py-10">
    <Breadcrumbs items={breadcrumbItems} />
    <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-green-700">
      <a href={`/category/${category}/`}>{categoryMeta.name}</a>
    </p>
    <h1 class="mb-3 text-3xl font-bold text-stone-900 sm:text-4xl">{title}</h1>
    <div class="mb-6 flex items-center gap-3">
      <a
        href={authorURL}
        class={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-xs font-bold text-white ${author.avatarClass}`}
        aria-hidden="true"
        tabindex="-1"
      >
        {author.initials}
      </a>
      <div class="text-sm">
        <p class="font-medium text-stone-700">
          By <a href={authorURL} rel="author" class="hover:text-green-700 hover:underline">{author.name}</a>
        </p>
        <p class="text-stone-500">
          Published {formatDate(pubDate)}
          {updatedDate && <> &middot; Updated {formatDate(updatedDate)}</>}
        </p>
      </div>
    </div>
    {heroImage && (
      <Image
        src={heroImage}
        alt={title}
        class="mb-8 w-full rounded-lg object-cover"
        widths={[400, 800, 1200]}
        sizes="(min-width: 768px) 768px, 100vw"
      />
    )}
    <div class="prose prose-lg prose-stone prose-headings:font-bold prose-a:text-green-700">
      <slot />
    </div>
    <aside class="mt-12 flex gap-4 rounded-lg border border-stone-200 bg-stone-50 p-5" aria-label="About the author">
      <a
        href={authorURL}
        class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-full font-bold text-white ${author.avatarClass}`}
        aria-hidden="true"
        tabindex="-1"
      >
        {author.initials}
      </a>
      <div class="text-sm text-stone-600">
        <p class="mb-1 font-semibold text-stone-900">
          <a href={authorURL} rel="author" class="hover:text-green-700 hover:underline">{author.name}</a>
          <span class="font-normal text-stone-500"> &middot; {author.role}</span>
        </p>
        <p class="mb-2">{author.bio}</p>
        <a href={authorURL} class="font-medium text-green-700 hover:underline">More from {author.name.split(' ')[0]} &rarr;</a>
      </div>
    </aside>
  </article>
  <NewsletterSignup />
  <RelatedPosts currentId={entry.id} category={category} />
</Layout>
