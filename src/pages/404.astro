---
import Layout from '../layouts/Layout.astro';
import { categories } from '../lib/categories';
---

<Layout
  title="Page Not Found"
  description="This page doesn't exist or has moved. Browse Suiep's categories to keep exploring."
  noindex
>
  <div class="mx-auto max-w-3xl px-4 py-20 text-center">
    <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-green-700">Error 404</p>
    <h1 class="mb-4 text-3xl font-bold text-stone-900 sm:text-4xl">We couldn't find that page</h1>
    <p class="mx-auto mb-8 max-w-xl text-stone-600">
      The link may be outdated or the content was moved. Head back home or pick a category below.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="rounded-full bg-green-700 px-5 py-2 text-sm font-semibold text-white hover:bg-green-800"
      >
        Home
      </a>
      {
        Object.entries(categories).map(([slug, cat]) => (
          <a
            href={`/category/${slug}/`}
            class="rounded-full border border-stone-200 px-5 py-2 text-sm font-semibold text-stone-700 hover:border-green-700 hover:text-green-700"
          >
            {cat.name}
          </a>
        ))
      }
    </div>
  </div>
</Layout>
