---
import Layout from '../../../layouts/Layout.astro';
import PostCard from '../../../components/PostCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { categories, type CategorySlug } from '../../../lib/categories';

export async function getStaticPaths() {
  return (Object.keys(categories) as CategorySlug[]).map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params as { category: CategorySlug };
const meta = categories[category];

const posts = (
  await getCollection('blog', ({ data }) => !data.draft && data.category === category)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title={meta.name} description={meta.description}>
  <div class="mx-auto max-w-5xl px-4 py-10">
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: meta.name }]} />
    <h1 class="mb-2 text-3xl font-bold text-stone-900">{meta.name}</h1>
    <p class="mb-8 text-stone-600">{meta.description}</p>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    {posts.length === 0 && <p class="text-stone-500">No posts in this category yet. Check back soon!</p>}
  </div>
</Layout>
