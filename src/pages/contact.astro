---
import Layout from '../layouts/Layout.astro';
// TODO: replace with a real inbox for the domain (e.g. hello@suiep.com)
const contactEmail = 'hello@suiep.com';
---

<Layout title="Contact" description="Get in touch with the Suiep team.">
  <div class="mx-auto max-w-3xl px-4 py-12 prose prose-stone">
    <h1>Contact Us</h1>
    <p>
      Have a question, correction, or partnership inquiry? Email us at
      <a href={`mailto:${contactEmail}`}>{contactEmail}</a> and we'll get back to you as soon as
      possible.
    </p>
  </div>
</Layout>
