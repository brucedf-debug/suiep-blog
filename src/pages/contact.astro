---
import Layout from '../layouts/Layout.astro';
import { contactEmail, siteName } from '../lib/site';

const description = 'Get in touch with the Suiep team.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact | ${siteName}`,
  description,
  url: new URL('/contact/', Astro.site).toString(),
};
---

<Layout title="Contact" description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="mx-auto max-w-3xl px-4 py-12 prose prose-stone">
    <h1>Contact Us</h1>
    <p>
      Have a question, correction, or partnership inquiry? Email us at
      <a href={`mailto:${contactEmail}`}>{contactEmail}</a> and we'll get back to you as soon as
      possible.
    </p>
  </div>
</Layout>
