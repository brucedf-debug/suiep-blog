---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { categories } from '../lib/categories';
import { siteTagline } from '../lib/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);
---

<Layout
  title="Home & Garden Ideas That Work"
  description="Smart upgrades for indoor & exterior projects — practical gardening, DIY, and home improvement guides you can actually finish this weekend."
>
  <section class="border-b border-stone-200 bg-stone-50">
    <div class="mx-auto max-w-5xl px-4 py-16 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-green-700">{siteTagline}</p>
      <h1 class="mb-4 text-4xl font-bold text-stone-900 sm:text-5xl">
        Grow, build, and improve your home
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-stone-600">
        Practical gardening tips, weekend DIY projects, and honest tool reviews &mdash; written to
        help you actually finish what you start.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="mb-6 text-2xl font-bold text-stone-900">Latest Posts</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    {posts.length === 0 && (
      <p class="text-stone-500">No posts published yet. Check back soon!</p>
    )}
  </section>

  <section class="border-t border-stone-200 bg-stone-50">
    <div class="mx-auto max-w-5xl px-4 py-12">
      <h2 class="mb-6 text-2xl font-bold text-stone-900">Browse by Category</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          Object.entries(categories).map(([slug, cat]) => (
            <a
              href={`/category/${slug}/`}
              class="rounded-lg border border-stone-200 bg-white p-5 transition hover:shadow-md"
            >
              <h3 class="mb-1 font-bold text-stone-900">{cat.name}</h3>
              <p class="text-sm text-stone-600">{cat.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
